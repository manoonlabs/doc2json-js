{
  "name": "@manoonlabs/doc2json",
  "version": "0.1.1",
  "description": "Official JavaScript/TypeScript SDK for doc2json: turn PDFs and images into structured JSON.",
  "keywords": [
    "doc2json",
    "json-extraction",
    "document-parsing",
    "invoice-parser",
    "pdf-to-json",
    "ocr",
    "pdf",
    "invoice",
    "receipt",
    "structured-data",
    "citations",
    "typescript",
    "zod",
    "sdk"
  ],
  "homepage": "https://doc2json.manoonlabs.com",
  "bugs": {
    "url": "https://github.com/manoonlabs/doc2json-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manoonlabs/doc2json-js.git"
  },
  "license": "MIT",
  "author": "ManoonLabs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^18.19.130",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
